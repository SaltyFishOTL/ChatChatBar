<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Legacy records can retain credentials until device-local migration succeeds. -->
        <exclude domain="file" path="entities/app_settings.json" />
        <exclude domain="file" path="entities/.app-settings-staging" />
        <exclude domain="file" path="entities/model_configs" />
        <exclude domain="file" path="entities/retrieval_model_config" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="entities/app_settings.json" />
        <exclude domain="file" path="entities/.app-settings-staging" />
        <exclude domain="file" path="entities/model_configs" />
        <exclude domain="file" path="entities/retrieval_model_config" />
    </device-transfer>
</data-extraction-rules>
